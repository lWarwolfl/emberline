DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4173

# Optional public-room relay (coturn REST authentication). Never expose the shared secret in client code.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=the-same-random-secret-configured-in-coturn

# Optional server-only donation verification services (mainnet only).
# Defaults use free public services. A free TronGrid key is recommended for production.
# DONATION_ETH_RPC=https://ethereum-rpc.publicnode.com
# DONATION_BNB_RPC=https://bsc-dataseed.bnbchain.org
# DONATION_BTC_API=https://blockstream.info/api
# DONATION_SOL_RPC=https://api.mainnet-beta.solana.com
# DONATION_TRON_API=https://api.trongrid.io
# TRONGRID_API_KEY=your-free-server-side-trongrid-key
